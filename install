#!/usr/bin/env python3
from getpass import getuser
from pathlib import Path
import subprocess
import sys
import traceback

paths = {
    ".bash_profile": "bash_profile",
    ".bashrc": "bashrc",
    ".claude/CLAUDE.md": "claude/CLAUDE.md",
    ".claude/coding-guidelines/bash.md": "claude/coding-guidelines/bash.md",
    ".claude/coding-guidelines/comments.md": "claude/coding-guidelines/comments.md",
    ".claude/coding-guidelines/review.md": "claude/coding-guidelines/review.md",
    ".claude/hooks/review-changed-code": "claude/hooks/review-changed-code",
    ".claude/settings.json": "claude/settings.json",
    ".claude/skills/babysit-stack/SKILL.md": "claude/skills/babysit-stack.md",
    ".claude/skills/handle-pr-feedback/SKILL.md": "claude/skills/handle-pr-feedback.md",
    ".claude/statusline": "claude/statusline",
    ".claude/workflows/jj.md": "claude/workflows/jj.md",
    ".claude/workflows/prs.md": "claude/workflows/prs.md",
    ".claude/workflows/writing-as-claude.md": "claude/workflows/writing-as-claude.md",
    ".config/helix/config.toml": "helix/config.toml",
    ".config/helix/languages.toml": "helix/languages.toml",
    ".config/helix/themes/kalgykai-dark.toml": "helix/kalgykai-dark.toml",
    ".config/jj/config.toml": "jj-config.toml",
    ".gitconfig": "gitconfig",
    ".inputrc": "inputrc",
    ".local/share/graphite/nuxes": "graphite_nuxes",
    ".tmux.conf": "tmux.conf",
    "bin/ask-llm": "bin/ask-llm",
    "bin/copy": "bin/copy",
    "bin/e": "bin/e",
    "bin/jfd": "bin/jfd",
    "bin/jj-fix-bookmarks": "bin/jj-fix-bookmarks",
    "bin/jj-log-watch": "bin/jj-log-watch",
}


def log(s: str) -> None:
    print(s, file=sys.stderr)


def install() -> None:
    if getuser() not in ["pylon", "coder"]:
        raise RuntimeError("Current user is not 'pylon'; refusing to install")

    for dest_relpath, source_relpath in paths.items():
        source = Path.cwd() / source_relpath
        dest = Path.home() / dest_relpath

        if not source.exists():
            log(f"MISSING {source_relpath}")
            continue

        if dest.exists() and source.samefile(dest):
            log(f"OK {dest}")
            continue

        if dest.is_file() or dest.is_symlink():
            backup = dest.with_name(f"{dest.name}.dotfiles-original")
            log(f"mv {dest} -> {backup}")
            dest.rename(backup)
        elif dest.exists():
            log(f"???? {dest}")
            continue

        if "/" in dest_relpath and not dest.parent.is_dir():
            log(f"mkdir {dest.parent}")
            dest.parent.mkdir(parents=True)

        log(f"link {dest} -> {source}")
        dest.symlink_to(source)


def fetch_and_rebase():
    if not Path(".jj").exists():
        subprocess.run("jj git init", shell=True, check=True)
        subprocess.run("jj bookmark track main --remote=origin", shell=True, check=True)
    subprocess.run("jj git fetch && jj rebase -d main", shell=True, check=True)


if __name__ == "__main__":
    if "--help" in sys.argv:
        print("usage: ./install [--no-fetch]")
        sys.exit(0)
    if "--no-fetch" not in sys.argv:
        try:
            fetch_and_rebase()
        except subprocess.CalledProcessError:
            log("error: jj init/fetch/rebase failed:")
            traceback.print_exc()
            log("Continuing anyway...")
    install()
