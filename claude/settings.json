{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "awaySummaryEnabled": false,
  "defaultMode": "acceptEdits",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(gt *)"
    ]
  },
  "preferredNotifChannel": "terminal_bell",
  "skillOverrides": {
    "address-reviewer-feedback": "off",
    "link-stack-to-linear": "off",
    "monitor-pr": "off",
    "new-pr": "off",
    "new-worktree": "off",
    "repair-ci-failures": "off",
    "resolve-merge-conflicts": "off"
  },
  "skipAutoPermissionPrompt": true,
  "theme": "dark-ansi"
}
